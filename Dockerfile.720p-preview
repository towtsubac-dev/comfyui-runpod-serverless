# Preview-only overlay. Keep model weights and existing runtime intact.
# Base is the existing GHCR main build; this tag is checked and recorded in CI.
FROM --platform=linux/amd64 ghcr.io/towtsubac-dev/comfyui-runpod-serverless:latest
WORKDIR /workspace
COPY --link handler.py /workspace/handler.py
COPY --link ref2va_handler.py /workspace/ref2va_handler.py
COPY --link video_720p.py /workspace/video_720p.py
COPY --link tests/test_video_720p.py /workspace/tests/test_video_720p.py
RUN python -m py_compile /workspace/handler.py /workspace/ref2va_handler.py /workspace/video_720p.py \
    && python -m unittest discover -s /workspace/tests -p 'test_video_720p.py' -v
CMD ["python", "/workspace/handler.py"]
